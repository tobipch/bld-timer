# Neon Postgres connection string (Vercel: add as env var).
# Without it the app runs in local mode (browser storage, no accounts).
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Secret for better-auth session cookies (required in production when
# DATABASE_URL is set). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the deployment, e.g. https://bld-timer.vercel.app
BETTER_AUTH_URL=

# Unauthenticated visitors act as a shared default user ("guest mode").
# Set to "false" to require login.
ALLOW_GUEST_FALLBACK=true
